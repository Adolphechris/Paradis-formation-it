rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: each user document stored under users/{uid}
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Progress documents: only owner can write/read
    match /progress/{documentId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.ownerUid || request.auth.uid == request.resource.data.ownerUid;
    }

    // Public lessons collection: read allowed to anyone
    match /lessons/{doc} {
      allow read: if true;
      allow write: if false; // lesson content managed via repo / admin tools
    }

    // Projects: owner can write, admins (team) can read/write
    match /projects/{projId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.uid == request.resource.data.ownerUid);
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
