# Example environment variables for PARADIS Firestore client
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=paradis-paradis-it
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:123456789:web:abcdefg

# For local development, create a .env.local file in `site/` with these values (do not commit secrets)
