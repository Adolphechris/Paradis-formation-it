# ─────────────────────────────────────────────────────────────────────────────
# PARADIS IT — Variables d'environnement (GABARIT)
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCTIONS :
#   1. Copiez ce fichier en .env : cp .env.example .env
#   2. Remplissez les valeurs réelles dans .env
#   3. NE COMMITEZ JAMAIS .env dans le dépôt (il est dans .gitignore)
#
# Pour trouver ces valeurs :
#   → https://supabase.com/dashboard/project/[votre-projet] → Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# URL du projet Supabase (ex: https://iwwohgdbdrlodhhgewut.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Clé ANON publique (safe pour le frontend — PAS la service_role key)
# Trouvable dans : Dashboard → Settings → API → Project API keys → anon (public)
SUPABASE_ANON_KEY=your-anon-key-here

# Mot de passe de la base de données (nécessaire pour supabase db push)
# Trouvable dans : Dashboard → Settings → Database → Connection string
SUPABASE_DB_PASSWORD=your-database-password-here

# Token d'accès personnel Supabase (pour le CLI — à révoquer après usage)
# Créer sur : https://supabase.com/dashboard/account/tokens
# ATTENTION : Ce token donne un accès complet à tous vos projets Supabase.
#             Révoquez-le immédiatement après les opérations CLI.
SUPABASE_ACCESS_TOKEN=your-access-token-here
